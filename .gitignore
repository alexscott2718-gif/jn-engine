build/*.omtc
build/m7c/
core.*
*.o
*.d
jnengine
web/*
!web/shell.html
# grn-catalog page is hand-authored source (track it), unlike the rest of web/*
# which is generated WASM output. Its data/models/thumbs are generated at deploy
# time (from the runtime capture dir) and stay untracked.
!web/grn-catalog/
!web/grn-catalog/**
web/grn-catalog/data/
web/grn-catalog/models/
web/grn-catalog/thumbs/
demo.omtc
demo.omtc.tex
camera.cam
*.omtc

# Build outputs (screenshots, JSON reports, validator artifacts). The build/
# dir is a scratch space; check anything genuinely shippable into assets/.
build/*.png
build/*.json
build/*.md
build/*.txt
build/replay_*/
build/*_inspect/
build/*_inspect_*/
screenshot.png

# Python caches
__pycache__/
*.pyc

# Auto-generated browseable asset / texture galleries (regen via
# tools/gen_asset_galleries.py and tools/gen_texture_gallery.py)
docs/gallery-*.html
docs/texture-gallery.html

# Proxy build artifacts. The DLL can embed the receiver host IP supplied via
# -DOMTC_RECEIVER_IP=... at build time, so keep binaries out of the repo.
instrument/proxy/*.dll
instrument/proxy/*.pdb
instrument/proxy/*.obj
instrument/proxy/*.lib
instrument/proxy/*.exp
instrument/proxy/com_wrappers_gen.inc

# Local environment file -- host IPs, tokens, VNC passwords live here.
.env
.env.local
assets/glb/omt/gltf_manifest.json

# Proprietary original-game binaries/data — NEVER commit to the public repo
# (provide your own legitimate copy locally for asset extraction).
assets/exe/

# Extracted OMT audio (music/voice/sfx, ~70 MB of proprietary media). Kept on
# disk + regenerable via `tools/extract_all_omt.py --audio`; not committed.
assets/parsed/**/*_audio/

# Granny proxy build artifacts (same rationale as instrument/proxy/* above —
# the DLL can embed the receiver host IP at build time).
instrument/granny_proxy/*.dll
instrument/granny_proxy/*.pdb
instrument/granny_proxy/*.obj
instrument/granny_proxy/*.lib
instrument/granny_proxy/*.exp

# Staged JNvsJN web build output (generated by tools/stage_jnvsjn_web.sh)
build/jnvsjn_web/

# Asset portal staging output (regenerable via tools/build_asset_portal.py;
# deploys to /var/www/{jn-assets,jnvsjn-assets}). Large, never committed.
build/portal/
build/portal_jnvsjn/
